{
  "name": "froment-software",
  "version": "0.2.10",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "pnpm --filter @froment/web start",
    "build": "pnpm --recursive --if-present build",
    "build:app": "pnpm build && node tools/package-app.mjs",
    "pack:app": "pnpm build:app && npm pack ./packages/app",
    "watch": "pnpm --filter @froment/web watch",
    "test": "pnpm --filter @froment/web build && pnpm --recursive --if-present test",
    "test:watch": "pnpm --filter @froment/web test:watch",
    "test:interface": "playwright test --config tools/interface/playwright.config.mjs",
    "lint": "tsc -p tools/oxlint/tsconfig.json --noEmit && oxlint . && pnpm --filter @froment/web lint:templates",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "packageManager": "pnpm@11.25.0"
}
